# Python cache files (auto-generated, not needed in git)
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environment (each developer creates their own)
venv/
.venv/
env/

# Trained model file (too large for git, regenerated by running train.py)
models/*.joblib

# Dataset (regenerated by running generate_dataset.py)
datasets/*.csv

# Pytest cache
.pytest_cache/

# Environment variables (may contain API keys)
.env
.env.local

# OS files
.DS_Store
Thumbs.db
